# Copy to backend/.env and adjust. Never commit the real .env.

# Database: SQLite for local dev; PostgreSQL in production.
DATABASE_URL=sqlite:///./teamtrack.db
# DATABASE_URL=postgresql+psycopg://teamtrack:secret@localhost:5432/teamtrack

# Auth - use a long random value in production (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI. Without credentials the app uses a rule-based parser and record-only reports.
# LLM_PROVIDER: auto | groq | anthropic | fallback  (auto prefers Groq, then Claude)
LLM_PROVIDER=auto

# Groq (OpenAI-compatible, fast open models). MODEL is the Groq model id.
GROQ_API_KEY=
MODEL=qwen/qwen3.8-27b

# Claude (used when no Groq key is set)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_PARSE_EFFORT=low
LLM_REPORT_EFFORT=medium
# Server-side refusal fallbacks (re-runs a declined request on a fallback model). Set false to disable.
LLM_USE_SERVER_FALLBACKS=true

# Background scheduler for reminders and scheduled report drafts
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
